# ============================================================
# The Open Tab — environment variables
# Copy this file to ".env.local" and fill in the values.
# Add the SAME values in Vercel → Settings → Environment Variables for production.
# NEVER commit .env.local (it's gitignored).
# ============================================================

# --- Existing admin login (already set in Vercel) ---
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=any-long-random-string

# --- Supabase (Phase 1) ---
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET — server only, never expose

# --- Stripe (Phase 3) — use TEST keys first ---
# From: Stripe Dashboard → Developers → API keys (toggle to Test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx                      # SECRET
STRIPE_WEBHOOK_SECRET=whsec_xxx                    # SECRET — from the webhook you'll create
STRIPE_PRICE_ID=price_xxx                          # the $5/mo recurring price ID
